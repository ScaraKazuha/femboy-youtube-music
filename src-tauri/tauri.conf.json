{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Femboy YouTube Music",
  "version": "0.2.2",
  "identifier": "io.github.unofficial-youtube-music.desktop",
  "build": { "frontendDist": "../web" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwRDhEOEIzQTQyM0IwQzAKUldUQXNDT2tzOWpZY1BJOXM5WElqTXRERGplTUx4ZlZaL1AxdEZ6dklMY3VlbG5mMU1Uek5DSEYK",
      "endpoints": ["https://github.com/ScaraKazuha/femboy-youtube-music/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "category": "Music",
    "shortDescription": "Unofficial desktop wrapper for YouTube Music",
    "longDescription": "Unofficial Windows wrapper for music.youtube.com. Not affiliated with, endorsed by, or sponsored by Google or YouTube.",
    "copyright": "Copyright 2026 Femboy YouTube Music contributors",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
